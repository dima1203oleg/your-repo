{
  "name": "predator-analytics-v18",
  "version": "18.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:mock": "PORT=8001 node mock-backend/server.cjs",
    "dev:local": "concurrently -k \"npm run start:mock\" \"npm run dev\"",
    "build": "vite build",
    "start:static": "npx http-server ./dist -p 3003 -a 127.0.0.1",
    "check:dist-no-local": "node scripts/check_dist_forbidden.cjs",
    "build:verify": "npm run build && npm run check:dist-no-local",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:e2e": "TEST_BASE_URL=http://127.0.0.1:3003 npx playwright test tests/playwright/live.spec.js --browser=firefox --reporter=list",
    "sync:push": "bash scripts/sync_from_ai_studio.sh",
    "sync:pull": "bash scripts/sync_to_ai_studio.sh",
    "infra:bootstrap": "bash scripts/bootstrap.sh"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.1",
    "concurrently": "^8.2.0",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "http-server": "^14.1.1"
  }
}
