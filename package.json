{
  "name": "predator-analytics-v18",
  "version": "18.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:optimized": "vite --config vite.optimized.config.ts",
    "start:mock": "PORT=8001 node mock-backend/server.cjs",
    "dev:local": "concurrently -k \"npm run start:mock\" \"npm run dev\"",
    "build": "vite build",
    "build:optimized": "vite build --config vite.optimized.config.ts",
    "build:analyze": "vite build --mode analyze",
    "start:static": "npx http-server ./dist -p 3003 -a 127.0.0.1",
    "check:dist-no-local": "node scripts/check_dist_forbidden.cjs",
    "build:verify": "npm run build && npm run check:dist-no-local",
    "build:verify:optimized": "npm run build:optimized && npm run check:dist-no-local",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "preview": "vite preview",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:e2e": "TEST_BASE_URL=http://127.0.0.1:3003 npx playwright test tests/playwright/live.spec.js --browser=firefox --reporter=list",
    "serve:dist": "node scripts/serve-with-proxy.js",
    "start:real": "node real-backend/server.js",
    "test:e2e:local": "npm run build && (node real-backend/server.js & ) && (node scripts/serve-with-proxy.js & ) && TEST_BASE_URL=http://127.0.0.1:3003 npx playwright test tests/playwright/live.spec.js --browser=firefox --reporter=list",
    "sync:push": "bash scripts/sync_from_ai_studio.sh",
    "sync:pull": "bash scripts/sync_to_ai_studio.sh",
    "infra:bootstrap": "bash scripts/bootstrap.sh",
    "analyze": "npm run build && npx vite-bundle-analyzer dist"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/cssnano": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "cssnano": "^6.1.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "http-server": "^14.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.32",
    "rollup-plugin-visualizer": "^5.9.2",
    "tailwindcss": "^3.4.0",
    "terser": "^5.26.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
