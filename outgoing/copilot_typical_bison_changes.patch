++    findComponentFiles() {
++        try {
++            const result = execSync('find . -name "*.tsx" -o -name "*.jsx" | grep -E "(components|views)" | head -20', { encoding: 'utf8' });
++            return result.trim().split('\n').filter(file => file && existsSync(file));
++        } catch (error) {
