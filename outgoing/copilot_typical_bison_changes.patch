+# Production Docker Compose configuration
+# For Predator Analytics production deployment
+
+version: '3.8'
+
+services:
+  # Backend API Server
+  predator-backend:
+    build:
+      context: .
+      dockerfile: Dockerfile
+    container_name: predator-backend-prod
+    restart: unless-stopped
+    environment:
+      - NODE_ENV=production
+      - PORT=8001
+      - BACKEND_PORT=8001
+      - MONITORING_PORT=3004
+      - LOG_LEVEL=warn
+      - CACHE_TTL=300000
+    ports:
+      - "8001:8001"
+    volumes:
+      - ./logs:/app/logs
+      - ./data:/app/data
+    command: ["node", "real-backend/server.js"]
+    healthcheck:
+      test: ["CMD", "curl", "-f", "http://localhost:8001/health"]
+      interval: 30s
+      timeout: 10s
+      retries: 3
+      start_period: 40s
+    networks:
+      - predator-network
+    deploy:
+      resources:
+        limits:
+          memory: 1G
+          cpus: '0.5'
+        reservations:
+          memory: 512M
+          cpus: '0.25'
+
+  # Proxy Server (Main Entry Point)
+  predator-proxy:
+    build:
+      context: .
+      dockerfile: Dockerfile
+    container_name: predator-proxy-prod
+    restart: unless-stopped
+    environment:
+      - NODE_ENV=production
+      - PORT=3003
+      - BACKEND_PORT=8001
+      - MONITORING_PORT=3004
+      - LOG_LEVEL=warn
+      - CACHE_TTL=300000
+    ports:
+      - "3003:3003"
+    volumes:
+      - ./logs:/app/logs
+      - ./dist:/app/dist:ro
+    command: ["node", "simple-proxy.js"]
+    depends_on:
+      predator-backend:
+        condition: service_healthy
+    healthcheck:
+      test: ["CMD", "curl", "-f", "http://localhost:3003/health"]
+      interval: 30s
+      timeout: 10s
+      retries: 3
+      start_period: 40s
+    networks:
+      - predator-network
+    deploy:
+      resources:
+        limits:
+          memory: 512M
+          cpus: '0.25'
+        reservations:
+          memory: 256M
+          cpus: '0.1'
