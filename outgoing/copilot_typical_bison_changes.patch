++        
++        const variance = actual.reduce((sum, val) => {
++            const diff = val - (actual.reduce((s, v) => s + v, 0) / actual.length);
++            return sum + diff * diff;
++        }, 0) / actual.length;
++        
++        return Math.max(0, 1 - (mse / variance));
