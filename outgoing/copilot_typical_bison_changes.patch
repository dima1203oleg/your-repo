+            position: absolute;
+            cursor: pointer;
+            top: 0;
+            left: 0;
+            right: 0;
+            bottom: 0;
+            background-color: #ccc;
+            transition: .4s;
+        }
+
+        .slider:before {
+            position: absolute;
+            content: "";
+            height: 18px;
+            width: 18px;
+            left: 3px;
+            bottom: 3px;
+            background-color: white;
+            transition: .4s;
+        }
+
+        input:checked + .slider {
+            background-color: var(--primary);
+        }
+
+        input:checked + .slider:before {
+            transform: translateX(26px);
+        }
+
+        .slider.round {
+            border-radius: 24px;
+        }
+
+        .slider.round:before {
+            border-radius: 50%;
+        }
+    </style>
+
+    <script>
+        // Mobile App JavaScript
+        class PredatorAnalyticsMobile {
+            constructor() {
+                this.refreshInterval = 30000;
+                this.refreshTimer = null;
+                this.serverUrl = 'http://localhost:8001';
+                this.proxyUrl = 'http://localhost:3003';
+                this.monitoringUrl = 'http://localhost:3005';
+                this.currentView = 'dashboard';
+                this.alerts = [];
+                
+                this.initializeApp();
+            }
+
+            initializeApp() {
+                this.updateTime();
+                this.startAutoRefresh();
+                this.loadInitialData();
+                this.setupEventListeners();
+                
+                // Update time every second
+                setInterval(() => this.updateTime(), 1000);
+            }
+
+            updateTime() {
+                const now = new Date();
+                const timeString = now.toLocaleTimeString('uk-UA', { 
+                    hour: '2-digit', 
+                    minute: '2-digit' 
+                });
+                document.getElementById('current-time').textContent = timeString;
+            }
+
+            setupEventListeners() {
+                // Refresh rate selector
+                document.getElementById('refresh-rate').addEventListener('change', (e) => {
+                    this.refreshInterval = parseInt(e.target.value);
+                    this.startAutoRefresh();
+                });
+
+                // Push notifications
+                document.getElementById('push-notifications').addEventListener('change', (e) => {
+                    if (e.target.checked && 'Notification' in window) {
+                        Notification.requestPermission();
+                    }
+                });
+
+                // Pull to refresh (simplified)
+                let startY = 0;
+                document.addEventListener('touchstart', (e) => {
+                    startY = e.touches[0].clientY;
+                });
+
+                document.addEventListener('touchend', (e) => {
+                    const endY = e.changedTouches[0].clientY;
+                    if (endY - startY > 100 && window.scrollY === 0) {
+                        this.refreshData();
+                    }
+                });
+            }
+
+            async loadInitialData() {
+                await this.refreshData();
+            }
+
+            async refreshData() {
+                const refreshBtn = document.getElementById('refresh-btn');
+                refreshBtn.classList.add('spinning');
+
+                try {
+                    await Promise.all([
+                        this.updateSystemMetrics(),
+                        this.updateAPIStatus(),
+                        this.updateAnalytics(),
+                        this.updateAlerts()
+                    ]);
+                    
+                    this.updateCharts();
+                    this.updateLastUpdateTime();
+                    
+                    // Show success message
+                    this.showAlert('Data refreshed successfully', 'success');
+                    
+                } catch (error) {
+                    console.error('Error refreshing data:', error);
+                    this.showAlert('Failed to refresh data', 'danger');
+                } finally {
+                    refreshBtn.classList.remove('spinning');
+                }
+            }
+
+            async updateSystemMetrics() {
+                try {
+                    // Try monitoring server first
+                    let response = await fetch(`${this.monitoringUrl}/metrics`);
+                    if (!response.ok) throw new Error('Monitoring server unavailable');
+                    
+                    const data = await response.json();
+                    
+                    document.getElementById('cpu-metric').textContent = `${Math.round(data.system?.cpu || 0)}%`;
+                    document.getElementById('memory-metric').textContent = `${Math.round(data.system?.memory || 0)}%`;
+                    
+                } catch (error) {
+                    // Fallback to proxy/health
+                    try {
+                        const response = await fetch(`${this.proxyUrl}/health`);
+                        const data = await response.json();
+                        
+                        document.getElementById('cpu-metric').textContent = `${Math.round(data.cpu || 0)}%`;
+                        document.getElementById('memory-metric').textContent = `${Math.round(data.memory || 0)}%`;
+                    } catch (fallbackError) {
+                        // Show placeholder values
+                        document.getElementById('cpu-metric').textContent = '--';
+                        document.getElementById('memory-metric').textContent = '--';
+                    }
+                }
+            }
+
+            async updateAPIStatus() {
+                const apis = [
+                    { name: 'prozorro', url: '/api/v1/connectors/prozorro' },
+                    { name: 'nbu', url: '/api/v1/connectors/nbu' },
+                    { name: 'tax', url: '/api/v1/connectors/tax' },
+                    { name: 'customs', url: '/api/v1/connectors/customs' }
+                ];
+
+                for (const api of apis) {
+                    try {
+                        const response = await fetch(`${this.proxyUrl}${api.url}`);
+                        const data = await response.json();
+                        
+                        const statusIndicator = document.getElementById(`${api.name}-status`);
+                        const timeElement = document.getElementById(`${api.name}-time`);
+                        
+                        if (data.status === 'online' || response.ok) {
+                            statusIndicator.className = 'status-indicator status-online';
+                            timeElement.textContent = 'Online';
+                        } else {
+                            statusIndicator.className = 'status-indicator status-offline';
+                            timeElement.textContent = 'Offline';
+                        }
+                        
+                    } catch (error) {
+                        const statusIndicator = document.getElementById(`${api.name}-status`);
+                        const timeElement = document.getElementById(`${api.name}-time`);
+                        
+                        statusIndicator.className = 'status-indicator status-offline';
+                        timeElement.textContent = 'Error';
+                    }
+                }
+            }
+
+            async updateAnalytics() {
+                try {
+                    const response = await fetch(`${this.proxyUrl}/api/v1/system/metrics`);
+                    const data = await response.json();
+                    
+                    document.getElementById('requests-per-sec').textContent = data.requestsPerSecond || '--';
+                    document.getElementById('avg-response-time').textContent = data.avgResponseTime ? `${data.avgResponseTime}ms` : '--';
+                    document.getElementById('error-rate').textContent = data.errorRate ? `${data.errorRate}%` : '--';
+                    document.getElementById('uptime').textContent = data.uptime ? `${data.uptime}h` : '--';
+                    document.getElementById('connections').textContent = data.connections || '--';
+                    document.getElementById('cache-hit-rate').textContent = data.cacheHitRate ? `${data.cacheHitRate}%` : '--';
+                    
+                } catch (error) {
+                    // Set placeholder values
+                    ['requests-per-sec', 'avg-response-time', 'error-rate', 'uptime', 'connections', 'cache-hit-rate'].forEach(id => {
+                        document.getElementById(id).textContent = '--';
+                    });
+                }
+            }
+
+            async updateAlerts() {
+                try {
+                    const response = await fetch(`${this.monitoringUrl}/alerts`);
+                    const alerts = await response.json();
+                    
+                    this.alerts = alerts || [];
+                    this.renderAlerts();
+                    this.updateAlertBadge();
+                    
+                } catch (error) {
+                    // Create sample alerts for demo
+                    this.alerts = [
+                        { id: 1, message: 'High CPU usage detected', severity: 'warning', timestamp: Date.now() },
+                        { id: 2, message: 'API response time increased', severity: 'info', timestamp: Date.now() - 300000 }
+                    ];
+                    this.renderAlerts();
+                    this.updateAlertBadge();
+                }
+            }
+
+            renderAlerts() {
+                const alertsList = document.getElementById('alerts-list');
+                
+                if (this.alerts.length === 0) {
+                    alertsList.innerHTML = `
+                        <div class="metric-card">
+                            <div style="text-align: center; color: #6b7280; padding: 20px;">
+                                <i class="fas fa-check-circle" style="font-size: 2rem; margin-bottom: 10px;"></i>
+                                <div>No active alerts</div>
+                            </div>
+                        </div>
+                    `;
+                    return;
+                }
+                
+                alertsList.innerHTML = this.alerts.map(alert => `
+                    <div class="metric-card" style="border-left: 4px solid ${this.getSeverityColor(alert.severity)};">
+                        <div style="display: flex; justify-content: space-between; align-items: start;">
+                            <div>
+                                <div style="font-weight: 600; margin-bottom: 5px;">${alert.message}</div>
+                                <div style="font-size: 0.75rem; color: #6b7280;">
+                                    ${new Date(alert.timestamp).toLocaleString()}
+                                </div>
+                            </div>
+                            <span style="background: ${this.getSeverityColor(alert.severity)}; color: white; padding: 4px 8px; border-radius: 12px; font-size: 0.75rem;">
+                                ${alert.severity}
+                            </span>
+                        </div>
+                    </div>
+                `).join('');
+            }
+
+            getSeverityColor(severity) {
+                const colors = {
+                    'critical': '#ef4444',
+                    'high': '#f59e0b',
+                    'medium': '#3b82f6',
+                    'low': '#10b981',
+                    'info': '#6b7280'
+                };
+                return colors[severity] || '#6b7280';
+            }
+
+            updateAlertBadge() {
+                const badge = document.getElementById('alert-count');
+                const activeAlerts = this.alerts.filter(a => a.severity === 'critical' || a.severity === 'high').length;
+                
+                if (activeAlerts > 0) {
+                    badge.textContent = activeAlerts;
+                    badge.style.display = 'flex';
+                } else {
+                    badge.style.display = 'none';
+                }
+            }
+
+            updateCharts() {
+                // Performance chart
+                const performanceChart = document.getElementById('performance-chart');
+                const performanceData = Array.from({ length: 20 }, () => Math.random() * 100);
+                
+                performanceChart.innerHTML = performanceData.map(value => `
+                    <div class="chart-bar" style="height: ${value}%"></div>
+                `).join('');
+                
+                // Request chart
+                const requestChart = document.getElementById('request-chart');
+                const requestData = Array.from({ length: 20 }, () => Math.random() * 100);
+                
+                requestChart.innerHTML = requestData.map(value => `
+                    <div class="chart-bar" style="height: ${value}%"></div>
+                `).join('');
+            }
+
+            updateLastUpdateTime() {
+                document.getElementById('last-update').textContent = new Date().toLocaleString();
+                document.getElementById('server-url').textContent = this.proxyUrl;
+            }
+
+            showAlert(message, type = 'info') {
+                const alertBanner = document.getElementById('alert-banner');
+                alertBanner.className = `alert-banner ${type}`;
+                alertBanner.innerHTML = `
+                    <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-triangle' : 'info-circle'}"></i>
+                    <span>${message}</span>
+                `;
+                
+                // Auto-hide after 3 seconds
+                setTimeout(() => {
+                    alertBanner.className = 'alert-banner success';
+                    alertBanner.innerHTML = `
+                        <i class="fas fa-check-circle"></i>
+                        <span>System operating normally</span>
+                    `;
+                }, 3000);
+            }
+
+            startAutoRefresh() {
+                if (this.refreshTimer) {
+                    clearInterval(this.refreshTimer);
+                }
+                
+                this.refreshTimer = setInterval(() => {
+                    this.refreshData();
+                }, this.refreshInterval);
+            }
+        }
+
+        // View switching
+        function switchView(viewName) {
+            // Hide all views
+            document.querySelectorAll('.view').forEach(view => {
+                view.style.display = 'none';
+            });
+            
+            // Show selected view
+            document.getElementById(`${viewName}-view`).style.display = 'block';
+            
+            // Update navigation
+            document.querySelectorAll('.nav-item').forEach(item => {
+                item.classList.remove('active');
+            });
+            
+            event.target.closest('.nav-item').classList.add('active');
+            
+            // Update current view
+            app.currentView = viewName;
+        }
+
+        // Global refresh function
+        function refreshData() {
+            if (window.app) {
+                window.app.refreshData();
+            }
+        }
+
+        // Initialize app when DOM is ready
+        document.addEventListener('DOMContentLoaded', () => {
+            window.app = new PredatorAnalyticsMobile();
+        });
+
+        // Service Worker for PWA functionality
+        if ('serviceWorker' in navigator) {
+            navigator.serviceWorker.register('/mobile-app/sw.js').catch(() => {
+                // Service worker registration failed (likely in development)
+            });
+        }
+    </script>
+</body>
+</html>
