+        
+        this.alerts.forEach(alert => {
+            if (alert.status === 'active') {
+                alert.status = 'resolved';
+                alert.resolvedTime = new Date().toISOString();
+                alert.resolveReason = 'manual-clear';
+                
+                const rule = this.rules.get(alert.ruleId);
