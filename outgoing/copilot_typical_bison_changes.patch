+        selectedInstance.requests++;
+        
+        return {
+            instanceId: selectedInstance.id,
+            instanceLoad: selectedInstance.requests,
+            totalInstances: runningInstances.length
+        };
+    }
+
+    // Public API methods
+    getMetrics() {
+        return {
