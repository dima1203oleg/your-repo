+            rules: Array.from(this.rules.entries()).map(([id, rule]) => ({
+                id: rule.id,
+                name: rule.name,
+                triggerCount: rule.triggerCount,
+                lastTriggered: rule.lastTriggered,
+                activeAlerts: rule.activeAlerts.size
+            }))
+        };
+        
+        if (format === 'json') {
