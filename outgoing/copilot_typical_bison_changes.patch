++
++    const toggleLoop = () => setIsActive(!isActive);
++    
++    const vetoCycle = () => {
++        setIsActive(false);
++        if (loopTimeoutRef.current) clearTimeout(loopTimeoutRef.current);
++        setStage('IDLE');
