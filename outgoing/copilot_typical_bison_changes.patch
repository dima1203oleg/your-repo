+
+  vault:
+    enabled: true
+    address: "http://vault-active.vault.svc:8200"
+    role: "predator-role"
+  
+  # 🛡️ AI SAFETY & TRUTH PROTOCOLS
+  safety:
+    anti_hallucination: true
+    strict_mode: true
+    citation_required: true
+    fallback_message: "Немає достовірних даних / Інформація відсутня у відкритих джерелах"
+
+# Service Enablement Flags
+# NOTE: Disabled services where local charts are missing in export
